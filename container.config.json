{
  "containerName": "real-voice-mvp",
  "service": {
    "name": "real-voice-mvp",
    "envParams": {
      "DEEPSEEK_API_KEY": "在云托管控制台的「服务设置 → 环境变量」里填，不要写在这里",
      "DEEPSEEK_BASE_URL": "https://api.deepseek.com",
      "DEEPSEEK_MODEL": "deepseek-chat",
      "PROVIDER": "deepseek"
    },
    "remark": "川味小馆 AI 点餐助手后端"
  },
  "dockerfile": "Dockerfile",
  "protocol": "http",
  "port": 8080,
  "cpu": 1,
  "memory": 2048,
  "minRunningCount": 0,
  "maxRunningCount": 5,
  "version": "1.0.5"
}
