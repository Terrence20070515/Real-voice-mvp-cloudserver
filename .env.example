# 复制本文件为 .env 并填入真实值（.env 已被 gitignore，不会提交）

# LLM 提供商：deepseek 或 ollama
PROVIDER=deepseek

# DeepSeek 配置（PROVIDER=deepseek 时必填）
DEEPSEEK_API_KEY=sk-你的key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Ollama 本地配置（PROVIDER=ollama 时使用）
OLLAMA_BASE_URL=http://192.168.8.6:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# 微信小程序配置（可选，不配则用 mock 登录）
WX_APPID=wx8d06ce349f238f91
WX_SECRET=

# 语音识别（ASR）：小程序语音输入用
# 注册 https://cloud.siliconflow.cn 获取 key（SenseVoice 免费额度），填入 ASR_API_KEY
ASR_API_KEY=
ASR_BASE_URL=https://api.siliconflow.cn/v1
ASR_MODEL=FunAudioLLM/SenseVoiceSmall
