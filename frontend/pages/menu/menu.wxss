/* pages/menu/menu.wxss */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f5f5;
}

/* 顶部导航 */
.top-bar {
  background: linear-gradient(135deg, #d4232c, #b71c1c);
  padding: 60rpx 30rpx 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #fff;
}

.back-btn,
.placeholder {
  width: 100rpx;
  font-size: 28rpx;
}

.top-title {
  font-size: 34rpx;
  font-weight: bold;
}

/* 状态视图 */
.state-view {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
}

.state-icon {
  font-size: 60rpx;
  margin-bottom: 20rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #eee;
  border-top: 4rpx solid #d4232c;
  border-radius: 50%;
  margin-bottom: 20rpx;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 主体：左右两栏 */
.menu-container {
  flex: 1;
  display: flex;
  overflow: hidden;
}

/* 左侧分类侧边栏 */
.sidebar {
  width: 180rpx;
  height: 100%;
  background: #f0f0f0;
  flex-shrink: 0;
}

.sidebar-item {
  position: relative;
  padding: 32rpx 20rpx;
  font-size: 26rpx;
  color: #666;
  text-align: center;
  border-left: 6rpx solid transparent;
  word-break: break-all;
  line-height: 1.3;
}

.sidebar-item.active {
  background: #fff;
  color: #d4232c;
  font-weight: bold;
  border-left-color: #d4232c;
}

/* 右侧菜品列表 */
.dish-list {
  flex: 1;
  height: 100%;
  background: #fff;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.category-block {
  margin-bottom: 20rpx;
}

.category-header {
  font-size: 28rpx;
  font-weight: bold;
  color: #d4232c;
  padding: 30rpx 0 20rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.dish-row {
  display: flex;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.dish-emoji {
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  background: #fafafa;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.dish-content {
  flex: 1;
  min-width: 0;
}

.dish-name-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.dish-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-right: 10rpx;
}

.dish-spicy {
  font-size: 18rpx;
  color: #fff;
  background: #ff5722;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
}

.dish-desc {
  font-size: 22rpx;
  color: #888;
  display: block;
  margin-bottom: 10rpx;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.dish-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
}

.dish-price {
  font-size: 32rpx;
  font-weight: bold;
  color: #d4232c;
}

/* 数量加减按钮 */
.qty-control {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.qty-btn {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: bold;
}

.qty-plus {
  background: #d4232c;
  color: #fff;
}

.qty-minus {
  background: #fff;
  color: #d4232c;
  border: 2rpx solid #d4232c;
  width: 40rpx;
  height: 40rpx;
}

.qty-num {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  min-width: 30rpx;
  text-align: center;
}

/* ============ 底部购物车栏 ============ */
.cart-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 110rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
  display: flex;
  align-items: center;
  padding: 0 20rpx 0 30rpx;
  box-sizing: border-box;
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}

.cart-icon-wrap {
  position: relative;
  margin-right: 20rpx;
}

.cart-icon {
  width: 100rpx;
  height: 100rpx;
  background: #ccc;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin-top: -40rpx;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.15);
}

.cart-icon.active {
  background: linear-gradient(135deg, #d4232c, #b71c1c);
}

.cart-badge {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  min-width: 36rpx;
  height: 36rpx;
  background: #ff5722;
  color: #fff;
  font-size: 22rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
  border: 2rpx solid #fff;
}

.cart-info {
  flex: 1;
}

.cart-total {
  font-size: 32rpx;
  font-weight: bold;
  color: #999;
}

.cart-total.active {
  color: #333;
}

.cart-hint {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.submit-btn {
  background: #ccc;
  color: #fff;
  padding: 0 50rpx;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: bold;
}

.submit-btn:not(.disabled) {
  background: linear-gradient(135deg, #ff9800, #f57c00);
  box-shadow: 0 4rpx 10rpx rgba(255, 152, 0, 0.3);
}

.submit-btn:active {
  transform: scale(0.97);
}

/* ============ 购物车详情浮窗 ============ */
.cart-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
  z-index: 99;
}

.cart-popup {
  position: fixed;
  bottom: 110rpx;
  left: 20rpx;
  right: 20rpx;
  max-height: 700rpx;
  background: #fff;
  border-radius: 16rpx;
  z-index: 100;
  display: flex;
  flex-direction: column;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.15);
  overflow: hidden;
}

.cart-popup-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.cart-popup-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.clear-btn {
  font-size: 26rpx;
  color: #999;
}

.cart-popup-list {
  max-height: 600rpx;
  padding: 10rpx 30rpx;
}

.cart-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.cart-item-name {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.cart-item-price {
  font-size: 26rpx;
  color: #999;
  margin-right: 20rpx;
}

.cart-item-qty {
  font-size: 28rpx;
  color: #d4232c;
  font-weight: bold;
}

.cart-empty {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
  font-size: 26rpx;
}
