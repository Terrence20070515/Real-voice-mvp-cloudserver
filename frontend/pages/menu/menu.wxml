<!-- pages/menu/menu.wxml -->
<view class="page">
  <!-- 顶部导航 -->
  <view class="top-bar">
    <view class="back-btn" bindtap="goBack">{{i18n.back}}</view>
    <view class="top-title">{{i18n.fullMenu}}</view>
    <view class="top-lang" bindtap="toggleLang">{{i18n.langBtn}}</view>
  </view>

  <!-- 主体：左侧分类 + 右侧菜品 -->
  <view class="menu-container">
    <!-- 加载中 -->
    <view class="state-view" wx:if="{{loading}}">
      <view class="loading-spinner"></view>
      <text>{{i18n.loadingMenu}}</text>
    </view>

    <!-- 错误 -->
    <view class="state-view" wx:elif="{{error}}">
      <text class="state-icon">{{i18n.notice}}</text>
      <text>{{error}}</text>
    </view>

    <!-- 正常显示 -->
    <block wx:else>
      <!-- 左侧分类侧边栏 -->
      <scroll-view scroll-y class="sidebar">
        <view
          wx:for="{{categories}}"
          wx:key="name"
          class="sidebar-item {{activeCategory === item.name ? 'active' : ''}}"
          data-name="{{item.name}}"
          bindtap="selectCategory"
        >
          {{item.name}}
          <view class="sidebar-count" wx:if="{{activeCategory === item.name}}"></view>
        </view>
      </scroll-view>

      <!-- 右侧菜品列表 -->
      <scroll-view scroll-y class="dish-list" scroll-into-view="cat_{{activeCategory}}">
        <block wx:for="{{categories}}" wx:key="name">
          <view id="cat_{{item.name}}" class="category-block">
            <view class="category-header">{{item.name}}</view>
            <view
              wx:for="{{item.items}}"
              wx:for-item="dish"
              wx:key="name"
              class="dish-row"
            >
              <view class="dish-emoji">
                {{dish.showSpicy ? dish.spicyText : ''}}
              </view>
              <view class="dish-content">
                <view class="dish-name-row">
                  <text class="dish-name">{{dish.name}}</text>
                  <text class="dish-spicy" wx:if="{{dish.showSpicy}}">{{dish.spicyText}}</text>
                </view>
                <text class="dish-desc" wx:if="{{dish.showDesc}}">{{dish.description}}</text>
                <view class="dish-bottom">
                  <text class="dish-price">{{dish.price}}</text>
                  <view class="qty-control">
                    <view
                      wx:if="{{dish.cartQty > 0}}"
                      class="qty-btn qty-minus"
                      data-name="{{dish.name}}"
                      data-price="{{dish.priceNum}}"
                      bindtap="minusDish"
                    >−</view>
                    <text wx:if="{{dish.cartQty > 0}}" class="qty-num">{{dish.cartQty}}</text>
                    <view
                      class="qty-btn qty-plus"
                      data-name="{{dish.name}}"
                      data-price="{{dish.priceNum}}"
                      bindtap="addDish"
                    >+</view>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </block>
        <view style="height: 200rpx"></view>
      </scroll-view>
    </block>
  </view>

  <!-- 底部购物车栏 -->
  <view class="cart-bar" wx:if="{{!loading && !error}}">
    <view class="cart-icon-wrap" bindtap="toggleCart">
      <view class="cart-icon {{cartCount > 0 ? 'active' : ''}}">{{i18n.cart}}</view>
      <view class="cart-badge" wx:if="{{cartCount > 0}}">{{cartCount}}</view>
    </view>
    <view class="cart-info" bindtap="toggleCart">
      <view class="cart-total {{cartCount > 0 ? 'active' : ''}}">
        {{cartCount > 0 ? '¥' + cartTotal : i18n.noItems}}
      </view>
      <view class="cart-hint" wx:if="{{cartCount === 0}}">{{i18n.pickDishes}}</view>
    </view>
    <view
      class="submit-btn {{cartCount === 0 ? 'disabled' : ''}}"
      bindtap="submitOrder"
    >{{i18n.goOrder}}</view>
  </view>

  <!-- 购物车详情浮窗 -->
  <view class="cart-mask" wx:if="{{showCart}}" catchtap="closeCart"></view>
  <view class="cart-popup" wx:if="{{showCart}}">
    <view class="cart-popup-header">
      <text class="cart-popup-title">{{i18n.selected}}</text>
      <text class="clear-btn" bindtap="clearCart">{{i18n.clear}}</text>
    </view>
    <scroll-view scroll-y class="cart-popup-list">
      <block wx:for="{{categories}}" wx:key="name">
        <block wx:for="{{item.items}}" wx:for-item="dish" wx:key="name">
          <view class="cart-item" wx:if="{{dish.cartQty > 0}}">
            <text class="cart-item-name">{{dish.name}}</text>
            <text class="cart-item-price">{{dish.price}}</text>
            <view class="cart-item-qty">×{{dish.cartQty}}</view>
          </view>
        </block>
      </block>
      <view wx:if="{{cartCount === 0}}" class="cart-empty">{{i18n.cartEmpty}}</view>
    </scroll-view>
  </view>
</view>
