/* pages/home/home.wxss */
.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 60rpx;
}

/* ============ 顶部 Banner ============ */
.banner {
  position: relative;
  width: 100%;
}

.banner-bg {
  background: linear-gradient(135deg, #d4232c 0%, #b71c1c 100%);
  padding: 100rpx 40rpx 60rpx;
  border-radius: 0 0 40rpx 40rpx;
  position: relative;
  overflow: hidden;
}

.banner-bg::before {
  content: '';
  position: absolute;
  top: -50rpx;
  right: -50rpx;
  width: 250rpx;
  height: 250rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 50%;
}

.banner-bg::after {
  content: '';
  position: absolute;
  bottom: -80rpx;
  left: -60rpx;
  width: 200rpx;
  height: 200rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 50%;
}

.banner-content {
  position: relative;
  z-index: 1;
}

.brand-row {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.logo {
  width: 110rpx;
  height: 110rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  margin-right: 24rpx;
  backdrop-filter: blur(10rpx);
}

.brand-info {
  flex: 1;
}

.brand-name {
  font-size: 44rpx;
  font-weight: bold;
  color: #fff;
  letter-spacing: 4rpx;
  margin-bottom: 8rpx;
}

.brand-slogan {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

.brand-meta {
  display: flex;
  gap: 30rpx;
  margin-bottom: 16rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.meta-icon {
  font-size: 24rpx;
}

.meta-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

.address-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

/* ============ 功能宫格 ============ */
.function-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 24rpx;
  margin-top: -40rpx;
  position: relative;
  z-index: 2;
}

.grid-item {
  width: calc(50% - 12rpx);
  margin: 12rpx 6rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  position: relative;
  overflow: hidden;
}

.grid-item:active {
  transform: scale(0.97);
}

.main-grid-item {
  background: linear-gradient(135deg, #fff5f5, #fff);
}

.grid-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  margin-bottom: 16rpx;
}

.grid-icon-primary {
  background: linear-gradient(135deg, #d4232c, #b71c1c);
  box-shadow: 0 4rpx 10rpx rgba(212, 35, 44, 0.3);
}

.grid-icon-secondary {
  background: linear-gradient(135deg, #ff9800, #f57c00);
  box-shadow: 0 4rpx 10rpx rgba(255, 152, 0, 0.3);
}

.grid-icon-tertiary {
  background: linear-gradient(135deg, #4caf50, #388e3c);
  box-shadow: 0 4rpx 10rpx rgba(76, 175, 80, 0.3);
}

.grid-icon-quaternary {
  background: linear-gradient(135deg, #2196f3, #1976d2);
  box-shadow: 0 4rpx 10rpx rgba(33, 150, 243, 0.3);
}

.grid-label {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 6rpx;
}

.grid-desc {
  font-size: 22rpx;
  color: #999;
}

/* ============ 区段 ============ */
.section {
  margin: 40rpx 0;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 30rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.section-more {
  font-size: 24rpx;
  color: #d4232c;
}

/* ============ 招牌菜横滑 ============ */
.dish-scroll {
  white-space: nowrap;
  padding: 0 30rpx;
}

.dish-card {
  display: inline-block;
  width: 280rpx;
  background: #fff;
  border-radius: 16rpx;
  margin-right: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  vertical-align: top;
}

.dish-img {
  width: 100%;
  height: 180rpx;
  background: linear-gradient(135deg, #fff5f5, #ffebee);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 80rpx;
}

.dish-info {
  padding: 20rpx;
}

.dish-name-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.dish-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-right: 10rpx;
}

.dish-spicy {
  font-size: 18rpx;
  color: #fff;
  background: #ff5722;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
}

.dish-desc {
  font-size: 22rpx;
  color: #888;
  display: block;
  margin-bottom: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dish-price-row {
  display: flex;
  align-items: center;
}

.dish-price {
  font-size: 32rpx;
  font-weight: bold;
  color: #d4232c;
}

/* ============ 业务卡片 ============ */
.business-card {
  margin: 0 30rpx 30rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.biz-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}

.biz-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  background: #fff5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.biz-content {
  flex: 1;
}

.biz-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 6rpx;
}

.biz-desc {
  font-size: 24rpx;
  color: #888;
  display: block;
}

.biz-divider {
  height: 1rpx;
  background: #f0f0f0;
  margin: 0 100rpx;
}

/* ============ 底部 ============ */
.footer {
  padding: 40rpx;
  text-align: center;
}

.footer-text {
  font-size: 22rpx;
  color: #bbb;
}
