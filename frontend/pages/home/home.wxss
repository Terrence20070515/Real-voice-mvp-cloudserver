/* pages/home/home.wxss — 浅色极简，无 emoji，与网页版一致 */
page {
  background: #f5f6f7;
  color: #141719;
  font-size: 28rpx;
  line-height: 1.6;
}

.page {
  padding: 0 32rpx 60rpx;
}

/* ── 店名 ── */
.hero {
  padding: 56rpx 0 40rpx;
  text-align: center;
}
.hero-name {
  font-size: 60rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
  line-height: 1.3;
  margin-bottom: 12rpx;
}
.hero-meta {
  font-size: 26rpx;
  color: #8c959f;
}

/* ── AI 点单入口 ── */
.entry {
  display: flex;
  align-items: center;
  padding: 36rpx 40rpx;
  border-radius: 24rpx;
  background: #141719;
  color: #fff;
  margin-bottom: 44rpx;
}
.entry-hover {
  background: #2b3034;
}
.entry-badge {
  width: 76rpx;
  height: 76rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 500;
  margin-right: 28rpx;
  flex: 0 0 auto;
}
.entry-text {
  flex: 1;
  min-width: 0;
}
.entry-title {
  font-size: 30rpx;
  font-weight: 500;
  margin-bottom: 6rpx;
}
.entry-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.62);
}
.entry-arrow {
  font-size: 44rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-left: 16rpx;
}

/* ── 区块标题 ── */
.section-head {
  display: flex;
  align-items: baseline;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #eef0f2;
}
.section-title {
  font-size: 28rpx;
  font-weight: 500;
}
.section-note {
  font-size: 24rpx;
  color: #8c959f;
  margin-left: auto;
}

/* ── 分类 chips ── */
.cats {
  white-space: nowrap;
  padding: 24rpx 0 8rpx;
}
.cat-chip {
  display: inline-block;
  padding: 10rpx 26rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  background: #ffffff;
  border: 1rpx solid #e4e6e9;
  color: #5b646e;
  font-size: 26rpx;
}
.cat-chip.on {
  background: #141719;
  border-color: #141719;
  color: #fff;
}
.cat-count {
  margin-left: 8rpx;
  opacity: 0.55;
}

/* ── 菜品 ── */
.group {
  margin-top: 32rpx;
}
.group-name {
  font-size: 24rpx;
  color: #8c959f;
  letter-spacing: 1rpx;
  padding-bottom: 14rpx;
  border-bottom: 1rpx solid #eef0f2;
  margin-bottom: 8rpx;
}
.dish {
  display: flex;
  align-items: flex-start;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #eef0f2;
}
.dish:last-child {
  border-bottom: none;
}
.dish-main {
  flex: 1;
  min-width: 0;
}
.dish-line {
  display: flex;
  align-items: center;
}
.dish-name {
  font-size: 28rpx;
}
.tag-spicy {
  font-size: 22rpx;
  padding: 0 10rpx;
  margin-left: 12rpx;
  border-radius: 8rpx;
  background: #fdeceb;
  color: #b3261e;
}
.dish-desc {
  font-size: 24rpx;
  color: #8c959f;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.dish-price {
  font-size: 28rpx;
  margin-left: 20rpx;
  flex: 0 0 auto;
}

/* ── 空态 ── */
.empty {
  padding: 80rpx 20rpx;
  text-align: center;
  color: #8c959f;
  font-size: 26rpx;
  line-height: 1.9;
}
.empty-sub {
  font-size: 24rpx;
  color: #a8b0b8;
}

/* ── 底部入口 ── */
.foot-links {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 60rpx;
  padding-top: 32rpx;
  border-top: 1rpx solid #eef0f2;
}
.foot-link {
  font-size: 26rpx;
  color: #5b646e;
  padding: 0 32rpx;
}
.foot-divider {
  width: 1rpx;
  height: 24rpx;
  background: #e4e6e9;
}
