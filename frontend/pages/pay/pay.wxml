<!-- pages/pay/pay.wxml -->
<view class="page">
  <!-- 顶部导航 -->
  <view class="top-bar">
    <view class="back-btn" bindtap="backToChat">{{i18n.back}}</view>
    <view class="top-title">{{i18n.payTitle}}</view>
    <view class="top-lang" bindtap="toggleLang">{{i18n.langBtn}}</view>
  </view>

  <!-- 支付成功遮罩 -->
  <view class="pay-success-mask" wx:if="{{paySuccess}}">
    <view class="success-icon">✓</view>
    <view class="success-text">{{i18n.paySuccess}}</view>
  </view>

  <!-- 内容区 -->
  <scroll-view scroll-y class="content-scroll">
    <!-- 加载中 -->
    <view class="state-view" wx:if="{{loading}}">
      <view class="loading-spinner"></view>
      <text>{{i18n.queryingOrders}}</text>
    </view>

    <!-- 没有订单 -->
    <view class="state-view" wx:elif="{{orders.length === 0}}">
      <view class="empty-icon">{{i18n.emptyBadge}}</view>
      <text class="empty-text">{{i18n.noOrders}}</text>
      <text class="empty-tip">{{i18n.noOrdersTip}}</text>
      <view class="continue-btn" bindtap="continueOrder">{{i18n.goOrdering}}</view>
    </view>

    <!-- 订单列表 -->
    <block wx:else>
      <view class="section-title">{{i18n.orderList}}（{{orders.length}}）</view>
      <block wx:for="{{orders}}" wx:key="order_id">
        <view class="order-card {{item.paid ? 'paid' : 'unpaid'}}">
          <!-- 订单头 -->
          <view class="order-header">
            <view class="order-id">{{i18n.orderNo}} {{item.order_id}}</view>
            <view class="order-status {{item.paid ? 'status-paid' : 'status-unpaid'}}">
              {{item.paid ? i18n.paid : i18n.unpaid}}
            </view>
          </view>

          <!-- 订单详情 -->
          <view class="order-customer" wx:if="{{item.customer}}">
            <text class="customer-label">{{i18n.customer}}</text>
            <text class="customer-value">{{item.customer}}</text>
          </view>

          <!-- 菜品列表 -->
          <view class="dish-list">
            <view wx:for="{{item.items}}" wx:for-item="dish" wx:key="dish_id" class="dish-row">
              <view class="dish-name-row">
                <text class="dish-name">{{dish.dish_name}}</text>
                <text class="dish-qty">×{{dish.quantity}}</text>
              </view>
              <text class="dish-subtotal">¥{{dish.subtotal}}</text>
            </view>
          </view>

          <!-- 总价 -->
          <view class="order-total-row">
            <text class="total-label">{{i18n.totalLabel}}</text>
            <text class="total-price">¥{{item.total}}</text>
          </view>

          <!-- 支付按钮 -->
          <view
            wx:if="{{!item.paid}}"
            class="pay-btn {{payingOrderId === item.order_id ? 'paying' : ''}}"
            data-id="{{item.order_id}}"
            bindtap="payOrder"
          >
            {{payingOrderId === item.order_id ? i18n.paying : i18n.payNow + item.total}}
          </view>
          <view wx:else class="paid-stamp">{{i18n.paidStamp}}</view>
        </view>
      </block>

      <!-- 底部说明 -->
      <view class="footer-tip">
        <text>{{i18n.footerTip}}</text>
      </view>

    </block>
  </scroll-view>
</view>
