<!-- pages/chat/chat.wxml -->
<view class="page-container">
  <!-- 顶部导航栏（动态状态栏高度） -->
  <view class="top-bar" style="padding-top: {{statusBarHeight}}px;">
    <view class="top-btns">
      <view class="back-btn" bindtap="goBack">‹</view>
      <view class="menu-btn" bindtap="toggleMenu">菜单</view>
    </view>
    <view class="top-title">AI 点餐助手</view>
  </view>

  <!-- 聊天消息区域（动态调整底部留白，避免被面板/输入栏遮挡） -->
  <scroll-view
    class="chat-scroll"
    style="height: {{scrollHeight}}px;"
    scroll-y
    scroll-into-view="{{scrollToView}}"
    scroll-with-animation
    enhanced
    show-scrollbar="{{false}}"
    bindtap="onChatAreaTap"
  >
    <view class="chat-list" style="padding-top: {{navBarHeight}}px;">
      <block wx:for="{{messages}}" wx:key="id">
        <view id="{{item.id}}" class="msg-item {{item.role}}">
          <view class="avatar {{item.role}}">
            {{item.role === 'user' ? '我' : 'AI'}}
          </view>
          <view class="msg-wrapper">
            <view
              class="msg-bubble {{item.isVoice ? 'voice-bubble' : ''}}"
              data-url="{{item.voiceUrl}}"
              catchtap="{{item.isVoice ? 'playVoice' : ''}}"
            >
              <block wx:if="{{item.isVoice}}">
                <view class="voice-tri"></view>
                <text class="voice-len">{{item.duration}}″</text>
              </block>
              <block wx:else>{{item.content}}</block>
            </view>
            <!-- AI 回复里如果提到订单号，显示「去结账」按钮 -->
            <view
              wx:if="{{item.role === 'assistant' && item.hasOrder}}"
              class="pay-entry-btn"
              catchtap="goToPay"
            >去结账 ›</view>
            <text class="msg-time">{{item.time}}</text>
          </view>
        </view>
      </block>

      <!-- AI 正在输入 -->
      <view class="msg-item assistant" wx:if="{{isLoading}}">
        <view class="avatar assistant">AI</view>
        <view class="msg-wrapper">
          <view class="msg-bubble typing">
            <view class="typing-dot"></view>
            <view class="typing-dot"></view>
            <view class="typing-dot"></view>
          </view>
        </view>
      </view>

      <view id="last-msg" class="bottom-anchor"></view>
    </view>
  </scroll-view>

  <!-- 「+」面板：只保留「清空对话」 -->
  <view class="extra-panel {{showMorePanel ? 'panel-show' : ''}}" style="bottom: {{inputBarHeight}}px;">
    <view class="panel-list">
      <view class="panel-row" bindtap="clearChat">
        <text class="panel-row-text">清空对话</text>
      </view>
    </view>
  </view>

  <!-- 底部输入栏（圆形按钮 + 药丸输入框） -->
  <view class="input-bar" style="padding-bottom: {{keyboardHeight}}px;">
    <!-- 语音识别状态条 -->
    <view wx:if="{{recording}}" class="voice-status">
      <view class="voice-dot"></view>
      <text>正在聆听，请说出想点的菜…松手后自动发送文字</text>
    </view>
    <view class="input-row" id="inputRow">
      <!-- 左：语音 / 键盘切换（点一下切到长按语音，再点回打字） -->
      <view class="round-btn" bindtap="toggleInputMode">
        <view wx:if="{{voiceMode}}" class="kb-icon"></view>
        <view wx:else class="mic-icon"></view>
      </view>

      <!-- 语音模式：长按说话，松手转文字并发送 -->
      <view
        wx:if="{{voiceMode}}"
        class="hold-talk {{recording ? 'hold-talk-recording' : ''}}"
        bindtouchstart="voiceStart"
        bindtouchend="voiceEnd"
        bindtouchcancel="voiceEnd"
      >{{recording ? '松开 发送' : '按住 说话'}}</view>

      <!-- 打字模式：textarea 支持多行 + 自动高度 -->
      <view wx:else class="input-box">
        <textarea
          class="input-textarea"
          placeholder="发消息..."
          placeholder-class="input-placeholder"
          value="{{inputValue}}"
          focus="{{inputFocus}}"
          bindinput="onInput"
          bindfocus="onInputFocus"
          bindblur="onInputBlur"
          confirm-type="send"
          bindconfirm="sendMsg"
          show-confirm-bar="{{false}}"
          adjust-position="{{false}}"
          cursor-spacing="20"
          auto-height
          hold-keyboard
          disable-default-padding
        />
      </view>

      <!-- 右侧：有文字时是发送；否则是 +（面板里只有清空对话） -->
      <view
        wx:if="{{!voiceMode && inputValue.length > 0}}"
        class="send-btn {{isLoading ? 'disabled' : ''}}"
        bindtap="sendMsg"
      >{{isLoading ? '...' : '发送'}}</view>
      <view wx:else class="round-btn" bindtap="toggleMorePanel">
        <text class="plus-icon">{{showMorePanel ? '×' : '+'}}</text>
      </view>
    </view>
  </view>

  <!-- 菜单浮窗遮罩 -->
  <view class="menu-mask" wx:if="{{showMenu}}" catchtap="closeMenu"></view>

  <!-- 菜单浮窗内容 -->
  <view class="menu-popup" wx:if="{{showMenu}}">
    <view class="popup-header">
      <text class="popup-title">今日菜单</text>
      <view class="close-btn" bindtap="closeMenu">✕</view>
    </view>

    <view class="menu-state" wx:if="{{menuLoading}}">
      <view class="loading-spinner"></view>
      <text class="state-text">正在加载菜单...</text>
    </view>

    <view class="menu-state" wx:elif="{{menuData.length === 0}}">
      <text class="state-text">暂无菜品数据</text>
    </view>

    <scroll-view scroll-y class="menu-scroll" wx:else>
      <block wx:for="{{menuData}}" wx:key="name">
        <view class="category-section">
          <view class="category-title">{{item.name}}</view>
          <block wx:for="{{item.items}}" wx:for-item="dish" wx:key="name">
            <view class="menu-card">
              <view class="card-row">
                <view class="dish-name-wrap">
                  <text class="dish-name">{{dish.name}}</text>
                  <text class="dish-spicy" wx:if="{{dish.spicy !== '不辣'}}">{{dish.spicy}}</text>
                </view>
                <text class="dish-price">{{dish.price}}</text>
              </view>
              <text class="dish-desc">{{dish.description}}</text>
            </view>
          </block>
        </view>
      </block>
    </scroll-view>
  </view>
</view>
