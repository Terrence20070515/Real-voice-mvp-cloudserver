/* pages/chat/chat.wxss */
.page-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #ededed;
  position: relative;
  overflow: hidden;
}

/* ============ 顶部导航栏 ============ */
.top-bar {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: auto;
  padding: 10rpx 24rpx 10rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  background: linear-gradient(180deg, #141719 0%, #2b3034 100%);
  color: white;
  z-index: 100;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

/* 返回+菜单按钮合并左侧 */
.top-btns {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}

.back-btn,
.menu-btn {
  height: 60rpx;
  min-width: 60rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 30rpx;
  font-size: 26rpx;
  line-height: 1;
  white-space: nowrap;
  flex-shrink: 0;
  background: rgba(255, 255, 255, 0.2);
}

.back-btn {
  width: 60rpx;
  padding: 0;
  font-size: 34rpx;
}

.back-btn:active,
.menu-btn:active {
  background: rgba(255, 255, 255, 0.35);
}

.tts-on {
  background: rgba(255, 255, 255, 0.42);
}

.top-title {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
  font-size: 30rpx;
  font-weight: bold;
  letter-spacing: 1rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ============ 聊天滚动区域 ============ */
/* 高度由 JS 动态计算，通过 inline style 设置 */
.chat-scroll {
  padding: 0 30rpx;
  box-sizing: border-box;
}

/* 内容区：顶部留白给 fixed 导航栏，底部留白给舒适阅读 */
.chat-list {
  padding-bottom: 30rpx;
}

/* 单条消息 */
.msg-item {
  display: flex;
  margin-bottom: 30rpx;
  align-items: flex-start;
}

.msg-item.user {
  flex-direction: row-reverse;
}

/* 头像 */
.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 8rpx;
  margin: 0 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  flex-shrink: 0;
}

.avatar.user {
  background: #f0f0f0;
}

.avatar.assistant {
  background: linear-gradient(135deg, #141719, #2b3034);
  box-shadow: 0 4rpx 10rpx rgba(212, 35, 44, 0.3);
}

/* 消息包装器 */
.msg-wrapper {
  display: flex;
  flex-direction: column;
  max-width: 70%;
}

.msg-item.user .msg-wrapper {
  align-items: flex-end;
}

.msg-item.assistant .msg-wrapper {
  align-items: flex-start;
}

/* 气泡 */
.msg-bubble {
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  line-height: 1.5;
  word-wrap: break-word;
  white-space: pre-wrap;
  position: relative;
}

.msg-item.user .msg-bubble {
  background-color: #95ec69;  /* 微信绿 */
  color: #000;
  border-top-right-radius: 4rpx;
}

.msg-item.assistant .msg-bubble {
  background-color: #fff;
  color: #333;
  border-top-left-radius: 4rpx;
}

/* 气泡小三角（接近微信效果） */
.msg-item.user .msg-bubble::before {
  content: '';
  position: absolute;
  top: 24rpx;
  right: -14rpx;
  border: 8rpx solid transparent;
  border-left-color: #95ec69;
}

.msg-item.assistant .msg-bubble::before {
  content: '';
  position: absolute;
  top: 24rpx;
  left: -14rpx;
  border: 8rpx solid transparent;
  border-right-color: #fff;
}

.msg-time {
  font-size: 20rpx;
  color: #999;
  margin-top: 6rpx;
  padding: 0 10rpx;
}

/* 「去结账」入口按钮 */
.pay-entry-btn {
  margin-top: 10rpx;
  padding: 14rpx 24rpx;
  background: linear-gradient(135deg, #ff9800, #f57c00);
  color: #fff;
  font-size: 26rpx;
  border-radius: 12rpx;
  text-align: center;
  font-weight: 600;
  box-shadow: 0 4rpx 10rpx rgba(255, 152, 0, 0.3);
}

.pay-entry-btn:active {
  transform: scale(0.96);
}

/* 正在输入动画 */
.msg-bubble.typing {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 24rpx 28rpx;
}

.typing-dot {
  width: 12rpx;
  height: 12rpx;
  background: #bbb;
  border-radius: 50%;
  animation: typingBounce 1.2s infinite;
}

.typing-dot:nth-child(2) { animation-delay: 0.2s; }
.typing-dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes typingBounce {
  0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
  30% { transform: translateY(-10rpx); opacity: 1; }
}

.bottom-anchor {
  height: 1rpx;
}

/* ============ 底部输入栏（圆形按钮 + 药丸输入框）============ */
.input-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  background: #ffffff;
  border-top: 1rpx solid #ececec;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 200;
  transition: padding-bottom 0.2s ease-out;
}

.input-row {
  display: flex;
  align-items: flex-end;
  padding: 16rpx 22rpx;
  gap: 16rpx;
  min-height: 100rpx;
}

/* 圆形按钮（语音 / +） */
.round-btn {
  width: 76rpx;
  height: 76rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #141719;
  border-radius: 50%;
  background: #fff;
  color: #141719;
  margin-bottom: 2rpx;
  user-select: none;
  box-sizing: border-box;
}

.round-btn:active {
  background: #f2f3f4;
}

.round-btn-recording {
  background: #141719;
  color: #fff;
}

/* 麦克风图标（纯 CSS 绘制，无图片、无 emoji） */
.mic-icon {
  width: 34rpx;
  height: 34rpx;
  position: relative;
}

.mic-icon::before {
  content: '';
  position: absolute;
  left: 11rpx;
  top: 2rpx;
  width: 12rpx;
  height: 18rpx;
  border: 3rpx solid currentColor;
  border-radius: 7rpx;
  box-sizing: border-box;
}

.mic-icon::after {
  content: '';
  position: absolute;
  left: 5rpx;
  top: 13rpx;
  width: 24rpx;
  height: 12rpx;
  border: 3rpx solid currentColor;
  border-top-color: transparent;
  border-left-color: transparent;
  border-right-color: transparent;
  border-radius: 0 0 12rpx 12rpx;
  box-sizing: border-box;
}

.plus-icon {
  font-size: 46rpx;
  line-height: 1;
  font-weight: 300;
  color: inherit;
}

/* 键盘图标（语音模式下切回打字） */
.kb-icon {
  width: 34rpx;
  height: 24rpx;
  border: 3rpx solid currentColor;
  border-radius: 6rpx;
  position: relative;
  box-sizing: border-box;
}

.kb-icon::before {
  content: '';
  position: absolute;
  left: 4rpx;
  top: 4rpx;
  width: 4rpx;
  height: 4rpx;
  border-radius: 1rpx;
  background: currentColor;
  box-shadow: 7rpx 0 currentColor, 14rpx 0 currentColor,
              0 7rpx currentColor, 7rpx 7rpx currentColor, 14rpx 7rpx currentColor;
}

/* 按住说话（语音模式占位条） */
.hold-talk {
  flex: 1;
  height: 76rpx;
  margin-bottom: 2rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  border: 2rpx solid #e6e6e6;
  border-radius: 38rpx;
  font-size: 30rpx;
  color: #141719;
  user-select: none;
  -webkit-user-select: none;
}

.hold-talk-recording {
  background: #141719;
  border-color: #141719;
  color: #fff;
}

/* 输入框容器（药丸） */
.input-box {
  flex: 1;
  background: #fff;
  border: 2rpx solid #e6e6e6;
  border-radius: 38rpx;
  padding: 10rpx 26rpx;
  min-height: 76rpx;
  max-height: 220rpx;
  overflow-y: auto;
  margin-bottom: 2rpx;
  box-sizing: border-box;
}

/* textarea 自适应高度 */
.input-textarea {
  width: 100%;
  min-height: 52rpx;
  max-height: 180rpx;
  font-size: 32rpx;
  line-height: 1.5;
  color: #333;
  word-break: break-all;
}

.input-placeholder {
  color: #9b9b9b;
  font-size: 32rpx;
}

/* 发送按钮 */
.send-btn {
  background: #141719;
  color: #fff;
  padding: 0 30rpx;
  height: 76rpx;
  border-radius: 38rpx;
  font-size: 30rpx;
  margin-bottom: 2rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 108rpx;
}

.send-btn.disabled {
  background: #c8c8c8;
  color: #fff;
}

.send-btn:active {
  background: #2b3034;
}

/* ============ 扩展面板（只保留清空对话）============ */
.extra-panel {
  position: fixed;
  left: 0;
  width: 100%;
  background: #f7f7f7;
  z-index: 150;
  border-top: 1rpx solid #dcdcdc;
  /* 默认隐藏：高度0 + overflow hidden */
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.25s ease-out;
}

.extra-panel.panel-show {
  max-height: 160rpx;
}

.panel-list {
  padding: 8rpx 0;
}

.panel-row {
  padding: 30rpx 34rpx;
  font-size: 30rpx;
  color: #333;
}

.panel-row:active {
  background: #ececec;
}

.panel-row-text {
  font-size: 30rpx;
  color: #333;
}

/* ============ 菜单浮窗 ============ */
.menu-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.6);
  z-index: 1900;
}

.menu-popup {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 75vh;
  background: #fff;
  border-radius: 30rpx 30rpx 0 0;
  z-index: 1901;
  display: flex;
  flex-direction: column;
  animation: slideUp 0.25s ease-out;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.popup-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #eee;
}

.popup-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #141719;
}

.close-btn {
  font-size: 40rpx;
  color: #999;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.menu-scroll {
  flex: 1;
  height: 0;
  padding: 20rpx 30rpx;
  box-sizing: border-box;
}

.menu-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
}

.state-text {
  font-size: 26rpx;
  color: #888;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #eee;
  border-top: 4rpx solid #141719;
  border-radius: 50%;
  margin-bottom: 20rpx;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.category-section {
  margin-bottom: 30rpx;
}

.category-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #141719;
  margin-bottom: 15rpx;
  padding-left: 20rpx;
  border-left: 6rpx solid #141719;
}

.menu-card {
  background: #fafafa;
  padding: 22rpx;
  border-radius: 12rpx;
  margin-bottom: 15rpx;
}

.card-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.dish-name-wrap {
  display: flex;
  align-items: center;
  flex: 1;
}

.dish-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.dish-spicy {
  font-size: 20rpx;
  color: #fff;
  background: #ff5722;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  margin-left: 12rpx;
}

.dish-price {
  font-size: 30rpx;
  color: #141719;
  font-weight: bold;
}

.dish-desc {
  font-size: 24rpx;
  color: #666;
  display: block;
  line-height: 1.5;
}

/* ─── 语音输入 ─── */
.voice-status {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 24rpx 0;
  font-size: 24rpx;
  color: #666;
}

.voice-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #d4232c;
  animation: voice-pulse 1s ease-in-out infinite;
}

@keyframes voice-pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.3; transform: scale(0.8); }
}

/* ─── 语音播报开关 ─── */
.tts-toggle {
  opacity: 0.6;
}

.tts-toggle.tts-on {
  opacity: 1;
  background: rgba(212, 35, 44, 0.85);
  color: #fff;
}

/* ─── 语音气泡（微信风格：三角播放键 + 时长）─── */
.msg-bubble.voice-bubble {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 160rpx;
}

.voice-tri {
  width: 0;
  height: 0;
  border-top: 12rpx solid transparent;
  border-bottom: 12rpx solid transparent;
  border-left: 18rpx solid #333;
}

.voice-len {
  font-size: 26rpx;
  color: #666;
}
